FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=company
# Empty for the local docker-compose (no password). Production sets it from Secret Manager.
FALKORDB_PASSWORD=
# Local development only: set to true to seed the company graph on startup when it's empty.
# Leave empty in production; the graph is never seeded there.
SEED_ON_STARTUP=
# Which seed to load: company_brain (default, ourselves) or quillfern (the demo company).
SEED_COMPANY=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Slack Web API origin. Leave empty for Slack; scripts/replay_workspace.py points it at a local fake.
SLACK_API_BASE_URL=
SLACK_OWNER_ID=
SLACK_ADMIN_IDS=

# Multi-workspace install (/slack/oauth/install). Optional for a single workspace.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
PUBLIC_URL=
# Fernet key for stored bot tokens; needs the `cryptography` package. Without it tokens are stored unencrypted.
TOKEN_ENCRYPTION_KEY=
# Bearer token for /slack/oauth/install, /slack/status and DELETE /slack/workspace.
BRAIN_ADMIN_TOKEN=
# Bearer token for MCP clients at /mcp (read-only tools over the graph). Empty disables /mcp.
MCP_TOKEN=

LLM_API_KEY=
LLM_MODEL=

# GitHub App (docs/GITHUB.md). Optional; without these the /github routes answer 503.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# Locally, a path to the downloaded .pem. In production, GITHUB_PRIVATE_KEY holds the PEM on one line with \n escapes.
GITHUB_PRIVATE_KEY_PATH=
GITHUB_PRIVATE_KEY=
# The same app's OAuth credentials, used only to verify `link github`.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

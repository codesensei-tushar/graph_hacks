FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=company
# Empty for the local docker-compose (no password). Production sets it from Secret Manager.
FALKORDB_PASSWORD=
# Local development only: set to true to seed the company graph on startup when it's empty.
# Leave empty in production; the graph is never seeded there.
SEED_ON_STARTUP=
# Which seed to load: company_brain (default, ourselves) or quillfern (the demo company).
SEED_COMPANY=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Slack Web API origin. Leave empty for Slack; scripts/replay_workspace.py points it at a local fake.
SLACK_API_BASE_URL=
SLACK_OWNER_ID=
SLACK_ADMIN_IDS=

# Multi-workspace install (/slack/oauth/install). Optional for a single workspace.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
PUBLIC_URL=
# Fernet key for stored bot tokens; needs the `cryptography` package. Without it tokens are stored unencrypted.
TOKEN_ENCRYPTION_KEY=
# Bearer token for /slack/oauth/install, /slack/status and DELETE /slack/workspace.
BRAIN_ADMIN_TOKEN=
# Bearer token that lifts /mcp's per-address rate limit. /mcp (read-only tools over the graph) is public without it.
MCP_TOKEN=
# Serve /docs, /redoc and /openapi.json. They list every route, admin ones included: leave unset in production.
DOCS_ENABLED=

LLM_API_KEY=
LLM_MODEL=

# GitHub App (docs/GITHUB.md). Optional; without these the /github routes answer 503.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# Locally, a path to the downloaded .pem. In production, GITHUB_PRIVATE_KEY holds the PEM on one line with \n escapes.
GITHUB_PRIVATE_KEY_PATH=
GITHUB_PRIVATE_KEY=
# The same app's OAuth credentials, used only to verify `link github`.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set to true to post a heads-up in the Slack home channel when a public repo's pull request, by
# someone the company knows, is opened, reopened or marked ready for review and who_should_know
# finds owners who weren't on it. At most once per pull request every seven days; private repos
# never alert. Off when empty.
COORDINATION_ALERTS=

# Connectors (docs/CONNECTORS.md). Each source is configured by CONNECTOR_<SOURCE>_<FIELD>
# variables; once all of a source's required fields are set, it syncs on startup. Its data is
# read by every Slack asker and never by the public web page, the team pages or MCP.
# Jira Cloud (docs/JIRA.md): the site, an account's email and API token, and the project keys to sync.
CONNECTOR_JIRA_BASE_URL=
CONNECTOR_JIRA_EMAIL=
CONNECTOR_JIRA_API_TOKEN=
CONNECTOR_JIRA_PROJECTS=
# Optional; see docs/JIRA.md.
CONNECTOR_JIRA_PEOPLE=
CONNECTOR_JIRA_WEBHOOK_SECRET=
# HubSpot: a private app's access token; the rest are optional.
CONNECTOR_HUBSPOT_TOKEN=
CONNECTOR_HUBSPOT_PEOPLE=
CONNECTOR_HUBSPOT_API_VERSION=
CONNECTOR_HUBSPOT_CLIENT_SECRET=
